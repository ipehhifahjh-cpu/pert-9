<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Penyimpanan Room Database"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etJudulCatatan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Judul Catatan..." />

    <EditText
        android:id="@+id/etIsiCatatan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Isi Catatan..."
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTambahCatatan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Simpan"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnResetDatabase"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kosongkan DB" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daftar Catatan:"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/txtDaftarCatatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada data."
            android:textSize="14sp" />
    </ScrollView>

</LinearLayout>